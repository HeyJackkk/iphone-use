+    if (nil == buffer || data.length > 8192 || buffer.length > 8192 - data.length) {
+      [self.authenticationBuffers removeObjectForKey:client];
+      nw_connection_cancel(client);
+      return;
+    }
+    [buffer appendData:data];
+    NSData *separator = [@"\r\n\r\n" dataUsingEncoding:NSUTF8StringEncoding];
+    NSRange end = [buffer rangeOfData:separator options:0 range:NSMakeRange(0, buffer.length)];
+    if (end.location == NSNotFound) { return; }
+    NSString *headers = [[NSString alloc] initWithData:[buffer subdataWithRange:NSMakeRange(0, end.location)] encoding:NSUTF8StringEncoding];
+    NSArray<NSString *> *lines = [headers componentsSeparatedByString:@"\r\n"];
+    BOOL valid = lines.count > 0 && ([lines[0] isEqualToString:@"GET / HTTP/1.1"] || [lines[0] isEqualToString:@"GET / HTTP/1.0"]);
+    NSString *authorization = nil;
+    for (NSUInteger i = 1; valid && i < lines.count; i++) {
+      NSString *line = lines[i];
+      NSRange colon = [line rangeOfString:@":"];
+      if (colon.location == NSNotFound || colon.location == 0) { valid = NO; break; }
