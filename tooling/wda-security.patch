diff --git a/WebDriverAgentLib/Routing/FBIPhoneUseAuth.h b/WebDriverAgentLib/Routing/FBIPhoneUseAuth.h
new file mode 100644
index 0000000..0e86667
--- /dev/null
+++ b/WebDriverAgentLib/Routing/FBIPhoneUseAuth.h
@@ -0,0 +1,21 @@
+#ifndef FBIPhoneUseAuth_h
+#define FBIPhoneUseAuth_h
+#import <Foundation/Foundation.h>
+
+// Fail closed even if a runner was launched without its private environment.
+static BOOL FBIPhoneUseAuthorized(NSString *header)
+{
+  NSString *token = NSProcessInfo.processInfo.environment[@"IPHONE_USE_AUTH_TOKEN"];
+  if (token.length != 64 || header.length != 71) { return NO; }
+  for (NSUInteger i = 0; i < token.length; i++) {
+    unichar c = [token characterAtIndex:i];
+    if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) { return NO; }
+  }
+  NSString *expected = [@"Bearer " stringByAppendingString:token];
+  unsigned int difference = 0;
+  for (NSUInteger i = 0; i < expected.length; i++) {
+    difference |= (unsigned int)([expected characterAtIndex:i] ^ [header characterAtIndex:i]);
+  }
+  return difference == 0;
+}
+#endif
